{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pheat.tools.blankenberglab.org/schemas/reference-dataset-manifest.schema.json",
  "title": "PHEAT reference dataset manifest row",
  "type": "object",
  "required": [
    "corpus_id",
    "corpus_version",
    "record_id",
    "pdb_id",
    "source_format",
    "source_path",
    "source_checksum_sha256",
    "pheat_version",
    "parser_name",
    "atom_domain",
    "selected",
    "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "corpus_id": {"type": "string"},
    "corpus_version": {"type": "string"},
    "record_id": {"type": "string"},
    "pdb_id": {"type": "string"},
    "model_id": {"type": ["integer", "string", "null"]},
    "chain_id": {"type": ["string", "null"]},
    "entity_id": {"type": ["string", "null"]},
    "source_format": {"enum": ["pdb", "mmcif", "bcif", "mixed"]},
    "source_path": {"type": ["string", "null"]},
    "source_url": {"type": ["string", "null"]},
    "source_checksum_sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$|^$"},
    "pheat_version": {"type": "string"},
    "parser_name": {"type": "string"},
    "parser_version": {"type": ["string", "null"]},
    "atom_domain": {"type": "string"},
    "residue_count": {"type": ["integer", "null"], "minimum": 0},
    "atom_count": {"type": ["integer", "null"], "minimum": 0},
    "protein_heavy_atom_count": {"type": ["integer", "null"], "minimum": 0},
    "all_heavy_atom_count": {"type": ["integer", "null"], "minimum": 0},
    "experimental_method": {"type": ["string", "null"]},
    "resolution_angstrom": {"type": ["number", "null"]},
    "selected": {"type": "boolean"},
    "exclusion_reason": {"type": ["string", "null"]},
    "heterogen_summary": {"type": "array", "items": {"type": "object"}},
    "modified_residue_summary": {"type": "array", "items": {"type": "object"}},
    "ligand_summary": {"type": "array", "items": {"type": "object"}},
    "water_count": {"type": ["integer", "null"], "minimum": 0},
    "ion_count": {"type": ["integer", "null"], "minimum": 0},
    "unknown_component_ids": {"type": "array", "items": {"type": "string"}},
    "generated_artifacts": {"type": "object"},
    "generated_checksums": {"type": "object"},
    "created_at": {"type": "string"}
  }
}
