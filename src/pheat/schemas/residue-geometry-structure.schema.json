{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pheat.dev/schemas/residue-geometry-structure.schema.json",
  "title": "PHEAT Residue Geometry Structure",
  "description": "Canonical JSON representation for residue-level dihedral, bond-angle, and optional bond-length geometry.",
  "type": "object",
  "required": [
    "format",
    "version",
    "angle_units",
    "chi_order",
    "name",
    "metadata",
    "disulfide_bonds",
    "residues"
  ],
  "properties": {
    "format": {
      "const": "pheat.residue-geometry-structure"
    },
    "version": {
      "const": 1
    },
    "angle_units": {
      "enum": [
        "radians",
        "degrees"
      ]
    },
    "chi_order": {
      "const": "chi1_to_chiN"
    },
    "name": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "disulfide_bonds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disulfideBond"
      }
    },
    "residues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/residue"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "disulfideBond": {
      "type": "object",
      "required": [
        "chain_id_1",
        "resseq_1",
        "icode_1",
        "chain_id_2",
        "resseq_2",
        "icode_2",
        "source"
      ],
      "properties": {
        "chain_id_1": {
          "type": "string"
        },
        "resseq_1": {
          "type": "integer"
        },
        "icode_1": {
          "type": "string"
        },
        "chain_id_2": {
          "type": "string"
        },
        "resseq_2": {
          "type": "integer"
        },
        "icode_2": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "residue": {
      "type": "object",
      "required": [
        "name",
        "phi",
        "psi",
        "chi",
        "chain_id",
        "resseq"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "phi": {
          "$ref": "#/$defs/nullableNumber"
        },
        "psi": {
          "$ref": "#/$defs/nullableNumber"
        },
        "omega": {
          "description": "Optional peptide-bond dihedral CA(i)-C(i)-N(i+1)-CA(i+1).",
          "$ref": "#/$defs/nullableNumber"
        },
        "tau": {
          "description": "Optional intra-residue bond angle N(i)-CA(i)-C(i).",
          "$ref": "#/$defs/nullableNumber"
        },
        "theta": {
          "description": "Optional peptide-link bond angle CA(i)-C(i)-N(i+1).",
          "$ref": "#/$defs/nullableNumber"
        },
        "chi": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "chain_id": {
          "type": "string"
        },
        "resseq": {
          "$ref": "#/$defs/nullableInteger"
        },
        "icode": {
          "type": "string"
        },
        "bond_lengths": {
          "type": "object",
          "patternProperties": {
            "^[A-Z0-9]+-[A-Z0-9]+$": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
